/*
 * Conformance Test: Create Schedule
 *
 * A single-layer schedule anchored on one user, with a weekly_restriction so
 * the polymorphic Restriction SubResource is exercised end-to-end (the case
 * that PKL inherited-field reflection silently dropped). schedule-update.pkl
 * exercises an in-place description change.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@pagerduty/core/user.pkl" as User
import "@pagerduty/core/schedule.pkl" as Schedule

local stackName = "pagerduty-conformance"
local testRunID = read("env:FORMAE_TEST_RUN_ID")
local testDomain = read?("env:PAGERDUTY_TEST_DOMAIN") ?? "platform.engineering"

local anchor = new User.User {
  label = "conformance-sched-user"
  name = "formae-conformance-sched-\(testRunID)"
  email = "formae-conformance-sched-\(testRunID)@\(testDomain)"
  role = "user"
}

forma {
  new formae.Stack {
    label = stackName
    description = "PagerDuty plugin conformance"
  }

  new formae.Target {
    label = "pagerduty-sandbox"
    namespace = "PAGERDUTY"
    config = new Mapping {
      ["Type"] = "PAGERDUTY"
      ["Subdomain"] = "conformance"
    }
  }

  anchor

  new Schedule.Schedule {
    label = "conformance-schedule"
    name = "formae-conformance-sched-\(testRunID)"
    timeZone = "America/Los_Angeles"
    description = "Created by formae conformance test"
    scheduleLayers = new Listing {
      new Schedule.ScheduleLayer {
        name = "Layer 1"
        // Future time in the schedule's own UTC offset (PST, -08:00). PagerDuty
        // clamps a past `start` to "now" and re-expresses any `Z` time in the
        // schedule's zone, either of which breaks exact-match verification — a
        // future time already in the zone's offset round-trips verbatim.
        start = "2027-01-04T00:00:00-08:00"
        rotationVirtualStart = "2027-01-04T00:00:00-08:00"
        rotationTurnLengthSeconds = 604800
        users = new Listing { anchor.res.id }
        restrictions = new Listing {
          new Schedule.Restriction {
            type = "weekly_restriction"
            startTimeOfDay = "09:00:00"
            durationSeconds = 28800
            startDayOfWeek = 1
          }
        }
      }
    }
  }
}
