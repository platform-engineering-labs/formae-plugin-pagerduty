/*
 * Conformance Test: Update NotificationRule (in-place)
 *
 * Changes the mutable startDelayInMinutes; the user, contact method, and
 * urgency are kept identical so the harness sees a pure in-place update.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@pagerduty/core/user.pkl" as User
import "@pagerduty/core/contact_method.pkl" as ContactMethod
import "@pagerduty/core/notification_rule.pkl" as NotificationRule

local stackName = "pagerduty-conformance"
local testRunID = read("env:FORMAE_TEST_RUN_ID")
local testDomain = read?("env:PAGERDUTY_TEST_DOMAIN") ?? "platform.engineering"

local owner = new User.User {
  label = "conformance-nr-user"
  name = "formae-conformance-nr-\(testRunID)"
  email = "formae-conformance-nr-\(testRunID)@\(testDomain)"
  role = "user"
}

local cm = new ContactMethod.ContactMethod {
  label = "conformance-nr-cm"
  userId = owner.res.id
  methodType = "email_contact_method"
  methodLabel = "Work"
  address = "formae-conformance-nr-addr-\(testRunID)@\(testDomain)"
}

forma {
  new formae.Stack {
    label = stackName
    description = "PagerDuty plugin conformance"
  }

  new formae.Target {
    label = "pagerduty-sandbox"
    namespace = "PAGERDUTY"
    config = new Mapping {
      ["Type"] = "PAGERDUTY"
      ["Subdomain"] = "conformance"
    }
  }

  owner
  cm

  new NotificationRule.NotificationRule {
    label = "conformance-notification-rule"
    userId = owner.res.id
    contactMethodId = cm.res.id
    startDelayInMinutes = 5  // CHANGED
    urgency = "high"
  }
}
