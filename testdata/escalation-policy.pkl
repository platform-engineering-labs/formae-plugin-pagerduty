/*
 * Conformance Test: Create EscalationPolicy
 *
 * One escalation rule paging a single user (user_reference target), which
 * exercises the EscalationTarget SubResource discriminator.
 * escalation-policy-update.pkl exercises an in-place description change.
 *
 * Filename uses a hyphen, not an underscore: the conformance harness matches a
 * testdata file to its resource type by stripping hyphens and lowercasing, so
 * "escalation-policy" -> "escalationpolicy" == "EscalationPolicy".
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@pagerduty/core/user.pkl" as User
import "@pagerduty/core/escalation_policy.pkl" as EP

local stackName = "pagerduty-conformance"
local testRunID = read("env:FORMAE_TEST_RUN_ID")
local testDomain = read?("env:PAGERDUTY_TEST_DOMAIN") ?? "platform.engineering"

local anchor = new User.User {
  label = "conformance-ep-user"
  name = "formae-conformance-ep-\(testRunID)"
  email = "formae-conformance-ep-\(testRunID)@\(testDomain)"
  role = "user"
}

forma {
  new formae.Stack {
    label = stackName
    description = "PagerDuty plugin conformance"
  }

  new formae.Target {
    label = "pagerduty-sandbox"
    namespace = "PAGERDUTY"
    config = new Mapping {
      ["Type"] = "PAGERDUTY"
      ["Subdomain"] = "conformance"
    }
  }

  anchor

  new EP.EscalationPolicy {
    label = "conformance-ep"
    name = "formae-conformance-ep-\(testRunID)"
    description = "Created by formae conformance test"
    escalationRules = new Listing {
      new EP.EscalationRule {
        escalationDelayInMinutes = 10
        targets = new Listing {
          new EP.EscalationTarget {
            type = "user_reference"
            id = anchor.res.id
          }
        }
      }
    }
  }
}
