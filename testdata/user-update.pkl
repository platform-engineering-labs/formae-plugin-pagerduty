/*
 * Conformance Test: Update User (in-place)
 *
 * Changes mutable fields (description, jobTitle). The email and role are kept
 * identical so the harness sees a pure in-place update.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@pagerduty/core/user.pkl" as User

local stackName = "pagerduty-conformance"
local testRunID = read("env:FORMAE_TEST_RUN_ID")
local testDomain = read?("env:PAGERDUTY_TEST_DOMAIN") ?? "platform.engineering"

forma {
  new formae.Stack {
    label = stackName
    description = "PagerDuty plugin conformance"
  }

  new formae.Target {
    label = "pagerduty-sandbox"
    namespace = "PAGERDUTY"
    config = new Mapping {
      ["Type"] = "PAGERDUTY"
      ["Subdomain"] = "conformance"
    }
  }

  new User.User {
    label = "conformance-user"
    name = "formae-conformance-\(testRunID)"
    email = "formae-conformance-\(testRunID)@\(testDomain)"
    role = "user"
    description = "Updated by formae conformance test"  // CHANGED
    jobTitle = "On-call engineer"                        // ADDED
  }
}
